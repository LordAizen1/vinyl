{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vinyl",
  "version": "0.1.0",
  "identifier": "dev.lordaizen.vinyl",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "vinyl",
        "width": 460,
        "height": 273,
        "minWidth": 260,
        "minHeight": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "LordAizen1",
    "copyright": "Copyright (c) 2026 LordAizen1",
    "shortDescription": "A turntable for your desktop that spins whatever you are playing.",
    "longDescription": "A small always-there desktop widget: a turntable whose record spins, and whose tonearm tracks across, whatever is playing anywhere on Windows. Reads the system media session, so it works with Spotify, Apple Music, YouTube in a browser, and anything else that reports to Windows.",
    "licenseFile": "../LICENSE"
  }
}
